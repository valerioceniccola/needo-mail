{
  "name": "needo-mail",
  "productName": "Needo",
  "version": "0.1.4",
  "private": true,
  "description": "Needo: i tuoi account Gmail in un contenitore leggero per macOS, con pause e badge solo per gli account attivi",
  "author": "Valerio Ceniccola",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node node_modules/electron/install.js && electron-vite dev --watch",
    "build": "electron-vite build",
    "preview": "node node_modules/electron/install.js && electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "build:mac": "npm run typecheck && electron-vite build && electron-builder --mac",
    "build:mac:local": "npm run typecheck && electron-vite build && electron-builder --mac -c.mac.notarize=false",
    "postinstall": "node node_modules/electron/install.js",
    "release": "npm run typecheck && electron-vite build && electron-builder --mac --publish always"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.61.0",
    "motion": "^14.5.0",
    "radix-ui": "^1.8.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.9.3",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/valerioceniccola/needo-mail.git"
  }
}
